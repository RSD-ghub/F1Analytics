# ─────────────────────────────────────────────────────────────────────────────
# F1 Forecasting Platform — environment
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (required) ──────────────────────────────────────────────────────────
# core-api refuses to issue tokens without this, and refuses a key shorter than
# 32 bytes (RFC 7518 §3.2 for HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""

# ── Inkling via Tinker (optional) ────────────────────────────────────────────
# Powers Bernie and the blog's narration. Leave empty and both switch off
# cleanly — forecasts, scoring, the track record and the blog's factual content
# all work without it.
#
# Key from https://tinker-console.thinkingmachines.ai (Settings → API keys).
TINKER_API_KEY=""

# Verified against Tinker's docs (August 2026). The base already ends in
# /api/v1, so the client appends /chat/completions and nothing more.
TINKER_BASE_URL="https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1"
INKLING_MODEL="thinkingmachines/Inkling"

# none | minimal | low | medium | high | xhigh. Tinker defaults to high (0.9),
# which is slow and costly for rephrasing facts. Use "low" if metered.
INKLING_REASONING_EFFORT="medium"

# ── Local (non-Docker) runs only ─────────────────────────────────────────────
# Compose supplies container hostnames instead; these apply when running
# uvicorn directly on the host.
MONGO_URI="mongodb://localhost:27017"
INGESTION_SERVICE_URL="http://localhost:8001"
PREDICTION_SERVICE_URL="http://localhost:8002"
SCORING_SERVICE_URL="http://localhost:8003"

# ── Deployment (docker-compose.prod.yml only) ────────────────────────────────
# Unused locally; every one of these is required by the production compose file.

# The hostname Caddy requests a certificate for. Must already resolve to this
# machine, or the Let's Encrypt challenge fails.
DOMAIN="f1.example.com"
ACME_EMAIL="you@example.com"

# The production database is authenticated even though it publishes no host
# port. Two doors, because "it is only on the internal network" stops being
# true the moment anything else lands on that network.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MONGO_USER="f1"
MONGO_PASSWORD=""

# ── LLM budgets (public deployments) ─────────────────────────────────────────
# Only meaningful once the app has a URL, where the number of callers stops
# being one. Per-user first so one abusive account cannot deny everyone else;
# the global ceiling behind it, because per-user limits multiply by however
# many accounts someone can register. 0 disables a limit — fine locally,
# reckless in public.
BERNIE_CALLS_PER_USER_PER_DAY="20"
BERNIE_CALLS_PER_DAY="500"
